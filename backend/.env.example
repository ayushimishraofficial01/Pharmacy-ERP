# Copy to .env and fill in real values. NEVER commit the real .env file.

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017/pharmacy-erp

# --- JWT ---
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h

# --- Server ---
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# --- AI (optional — Phase 8 section 14/15) ---
# Core ERP works fully with AI_ENABLED=false. Never required.
AI_ENABLED=false
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# --- Email (not yet implemented in this merge — placeholder for whichever
#     phase's email flow gets wired in) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# --- WhatsApp (Stage 7 order management works without this — order
#     creation/conversion doesn't call an external WhatsApp API in this
#     merge; only needed if you wire in outbound message sending) ---
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Storage (not yet used — placeholder for file/image uploads if added) ---
STORAGE_PROVIDER=
STORAGE_BUCKET=

# --- GST Suvidha Provider / Portal integration (Phase 11 — GST Return
#     Filing). Return preparation, validation, and export (JSON/Excel/CSV)
#     work fully without these. Only live portal SUBMISSION
#     (POST /api/gst-returns/:id/submit) requires them — until set,
#     gstPortalService.js clearly refuses to submit rather than fabricating
#     a filed status or ARN. See backend/src/services/gstPortalService.js
#     for what still needs implementing once you have a GSP account. ---
GST_GSP_BASE_URL=
GST_GSP_CLIENT_ID=
GST_GSP_CLIENT_SECRET=
GST_GSP_USERNAME=
GST_GSP_OTP_MODE=
